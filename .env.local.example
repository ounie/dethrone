# ─────────────────────────────────────────────────────────────────────────────
# Dethrone Console
#
# Copy to .env.local. That file is gitignored; this one is not, so never put a
# real key here.
#
# Use a wallet that exists only for this console, funded with the session's
# budget and nothing more. Every safeguard below is a seatbelt in this app's own
# process; the mitigation that always works is that the reachable wallet is
# nearly empty.
# ─────────────────────────────────────────────────────────────────────────────

# The only secret. Server-side only — NEVER prefix any variable with
# NEXT_PUBLIC_, which inlines its value into the client bundle.
#
# Absent ⇒ read-only mode. The console still boots, every free read works, and
# every paid command renders disabled with the reason. A fresh clone cannot cost
# anything on its first run.
DETHRONE_PRIVATE_KEY=

# Where the canon lives. Point at http://127.0.0.1:3000 to drive a local arena.
DETHRONE_BASE_URL=https://dethrone.bot

# base | base-sepolia. Selects the CAIP-2 chain the x402 scheme registers under,
# and which USDC contract and block explorer the wallet readout points at.
DETHRONE_NETWORK=base

# Optional. Used for ONE read-only call: the operator wallet's USDC balance.
# Defaults to the chain's public RPC, which is rate-limited — set your own if
# the balance reads "unavailable". Nothing is ever signed or sent over it.
DETHRONE_RPC_URL=

# ── Money safety ─────────────────────────────────────────────────────────────

# The ceiling, in cents. Bounds ONE SITTING — restarting the process resets it.
#
# This is NOT escrow and NOT a protocol feature. It lives in this app's own
# process and protects against a stray click, not against a compromised host.
# On serverless without a KV store it cannot bound a sitting at all, and the
# console renders it as "disabled" rather than as a number that would be lying.
CONSOLE_MAX_SPEND_CENTS=5000

# Above this, a paid command requires an explicit confirmation naming the amount
# and the paying address. Caller-priced commands (a stake, a listing) always
# require one, regardless of amount. Must be <= CONSOLE_MAX_SPEND_CENTS.
CONSOLE_CONFIRM_OVER_CENTS=1000

# ── Deployment gates (see README "Where to run this") ────────────────────────

# Required to serve paid commands from a host that is not loopback. A dev server
# on 0.0.0.0 is a spending endpoint for everyone on the network.
CONSOLE_ALLOW_REMOTE=

# Required for a key on a Vercel preview. Preview deployments INHERIT
# environment variables, so a Preview-scoped key on an unprotected preview URL
# is a public wallet wearing a different hat.
CONSOLE_ALLOW_PREVIEW_KEY=

# Required for a key on Vercel production. The runtime cannot read Vercel's
# Deployment Protection setting, so this is an explicit acknowledgement that you
# turned it on. Someone who lies to it has made a choice; someone who forgot has
# been stopped.
CONSOLE_PROTECTION_CONFIRMED=

# Registers the $402.00 genesis lordship purchase. Off by default: a $402 button
# one click away from a $5.00 ceiling exists only to be refused or to be a
# catastrophe.
CONSOLE_ALLOW_GENESIS=

# Paid commands over the local dev bypass instead of real USDC. Requires the
# arena to be running with X402_DEV_BYPASS=1, and refuses unless
# DETHRONE_BASE_URL is loopback. This is how you exercise the paid path before
# any money moves.
CONSOLE_DEV_BYPASS=

# ── Optional: the ceiling on serverless ──────────────────────────────────────
#
# Serverless invocations do not share memory, so the in-process counter becomes
# a per-invocation check — which is nearly no protection. Set these to back the
# ceiling with Upstash Redis and restore it.
#
# @vercel/kv is deprecated in favour of the Upstash marketplace integration,
# whose variables are the two below. KV_URL is accepted as an alias only when it
# is an https:// REST URL; a bare redis:// on serverless is a boot warning, not
# a silent fallback to a client that will exhaust connections.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_URL=
